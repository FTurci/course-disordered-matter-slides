# LAMMPS script for Morse particles with high alpha parameter
# Simulates a fluid starting from random configuration

# Initialization
units           lj
atom_style      atomic
dimension       3
boundary        p p p


variable        temp equal 2.0

# System definition
region          box block 0 30 0 30 0 30
create_box      1 box
create_atoms    1 random 5000 12345 box

# Set mass
mass            1 1.0

# Morse potential parameters
# U(r) = D0 * [exp(-2*alpha*(r-r0)) - 2*exp(-alpha*(r-r0))]
# High alpha parameter for gel-like behavior
pair_style      morse 2.0
pair_coeff      1 1 1.0 30.0 1.0

# Initial velocity (low temperature for stability)
velocity        all create ${temp} 87287 dist gaussian

# Neighbor list settings
neighbor        0.3 bin
neigh_modify    every 10 delay 0 check yes

# Energy minimization to remove overlaps
minimize        1.0e-4 1.0e-6 1000 10000

# Reset velocities after minimization
velocity        all create ${temp} 87287 dist gaussian

# Langevin dynamics (almost overdamped)
# langevin temp_start temp_stop damp seed
fix             1 all langevin ${temp} ${temp} 0.1 48279
fix             2 all nve

# Output settings
timestep        0.005

thermo_style    custom step temp pe ke etotal press density
thermo          100


# Run 3: 10000-100000 steps, dump every 1000 steps
dump            3 all custom 1000 trajectory-temp${temp}.lammpstrj id type x y z
dump_modify     3 sort id 
run             1000000
undump          3



write_data      final_config.data
