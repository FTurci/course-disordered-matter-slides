Neighbor list builds = 30
Dangerous builds = 0

# Reset velocities after minimization
velocity        all create ${temp} 87287 dist gaussian
velocity        all create 2 87287 dist gaussian

# Langevin dynamics (almost overdamped)
# langevin temp_start temp_stop damp seed
fix             1 all langevin ${temp} ${temp} 0.1 48279
fix             1 all langevin 2 ${temp} 0.1 48279
fix             1 all langevin 2 2 0.1 48279
fix             2 all nve

# Output settings
timestep        0.005

thermo_style    custom step temp pe ke etotal press density
thermo          100


# Run 3: 10000-100000 steps, dump every 1000 steps
dump            3 all custom 1000 trajectory-temp${temp}.lammpstrj id type x y z
dump            3 all custom 1000 trajectory-temp2.lammpstrj id type x y z
dump_modify     3 sort id
run             1000000
